# Copy to .env for local use outside Docker Compose (Compose sets these itself).
# Infrastructure secrets only; provider, SMTP and Stripe keys live in Platform settings (ADR 0012).
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://root:test@localhost:3306/app_dev
REDIS_URL=redis://localhost:6379
# At least 32 characters
SESSION_SECRET=change-me-change-me-change-me-change-me
# 32 bytes, base64 (openssl rand -base64 32)
SETTINGS_ENCRYPTION_KEY=
APP_URL=http://localhost:5173
SENTRY_DSN=
# live | fake (fake is forbidden when NODE_ENV=production)
TOOLS_MODE=fake
