# Static site build for App Platform (the SPA at /app).
# Its own file because App Platform's builder skips unpacking a final stage with no commands,
# so a `FROM web AS final` stage leaves output_dir empty. Here the last stage runs the build.
FROM node:24-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY e2e/package.json e2e/
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build -w apps/web && test -f apps/web/dist/index.html
