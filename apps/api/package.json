{
  "name": "@app/api",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/scripts/migrate.ts up",
    "migrate:down": "tsx src/scripts/migrate.ts down",
    "seed": "tsx src/scripts/seed.ts",
    "staff:grant": "tsx src/modules/identity/scripts/staff.ts grant",
    "staff:revoke": "tsx src/modules/identity/scripts/staff.ts revoke",
    "staff:reset-2fa": "tsx src/modules/identity/scripts/staff.ts reset-2fa"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@app/contracts": "*",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@sentry/node": "11.11.0",
    "apify-client": "2.25.0",
    "bcryptjs": "3.0.3",
    "bullmq": "6.7.0",
    "csv-stringify": "6.9.0",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "kysely": "0.29.8",
    "mysql2": "3.24.6",
    "nodemailer": "10.3.1",
    "otplib": "13.6.0",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
